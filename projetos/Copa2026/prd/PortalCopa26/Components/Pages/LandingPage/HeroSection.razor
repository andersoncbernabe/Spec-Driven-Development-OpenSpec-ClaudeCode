<section class="hero">
    <div class="hero-inner">
        <div class="hero-text">
            <div class="hero-eyebrow">
                <span></span>Copa do Mundo FIFA 2026
            </div>
            <h1 class="hero-title">
                O Maior Torneio<br />
                do <span class="accent-gold">Planeta</span>
            </h1>
            <p class="hero-desc">
                48 seleções, 16 estádios, 3 países-sede e 104 jogos inesquecíveis.
                Acompanhe grupos, resultados e simule os placares.
            </p>
            <div class="hero-actions">
                <a href="/simulador" class="btn btn-gold btn-lg">Simular Torneio</a>
                <a href="/jogos" class="btn btn-outline btn-lg">Ver Jogos</a>
            </div>
        </div>

        <div class="hero-logo">
            <img src="https://api.fifa.com/api/v3/picture/tournaments-sq-4/285023"
                 alt="Copa do Mundo FIFA 2026"
                 onerror="this.style.display='none'" />
            <span class="hero-logo-label">FIFA World Cup 2026</span>
        </div>

        <div class="hero-flags">
            <div class="host-card">
                <img src="https://api.fifa.com/api/v3/picture/flags-sq-4/USA"
                     alt="Estados Unidos"
                     onerror="this.style.background='var(--border)'" />
                <div class="host-card-info">
                    <strong>Estados Unidos</strong>
                    <span>11 cidades-sede</span>
                </div>
            </div>
            <div class="host-card">
                <img src="https://api.fifa.com/api/v3/picture/flags-sq-4/CAN"
                     alt="Canadá"
                     onerror="this.style.background='var(--border)'" />
                <div class="host-card-info">
                    <strong>Canadá</strong>
                    <span>2 cidades-sede</span>
                </div>
            </div>
            <div class="host-card">
                <img src="https://api.fifa.com/api/v3/picture/flags-sq-4/MEX"
                     alt="México"
                     onerror="this.style.background='var(--border)'" />
                <div class="host-card-info">
                    <strong>México</strong>
                    <span>3 cidades-sede</span>
                </div>
            </div>
        </div>
    </div>
</section>
